# --- Secrets & local config (NEVER commit real credentials / personal info) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.secrets/
secrets.env
*.secrets.env
*.local
config.local.*
.ai_studio/

# Real policy rules live locally; only runtime/policy.example.yaml is committed
# (rules-as-data; a real deployment may grant broader capabilities — ADR-0011).
runtime/policy.yaml
runtime/policy.local.yaml

# Real model registry/routing policy lives locally; only
# runtime/models.example.yaml is committed (rules-as-data; ADR-0005/0011).
runtime/models.yaml
runtime/models.local.yaml

# Runtime inbound messages captured by the Spokesman may contain personal info
# (sender numbers, message bodies) — keep them out of git (ADR-0011).
state/inbox/whatsapp-inbound.jsonl
state/inbox/whatsapp-*.jsonl

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Node (for any dashboards / MCP servers in JS) ---
node_modules/
npm-debug.log*
pnpm-debug.log*
.next/
dist-ssr/

# --- Docker / data volumes (local-first source of truth lives outside git) ---
data/
volumes/
*.sqlite
*.db

# --- Observability / logs ---
logs/
*.log

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp
