# ===== AI Studio environment =====
# Copy to `.env` (git-ignored) via `scripts/onboarding.sh`. NEVER commit real
# values. Personal info (phone numbers, names) and secrets live ONLY in `.env`
# or an external secrets file (AI_STUDIO_SECRETS) — never in a tracked file.
#
# Leave blank anything you don't have yet; onboarding can be re-run to fill more.

AI_STUDIO_ENV=dev

# Optional: absolute path to an external secrets file (outside the repo) that is
# sourced in addition to .env. Preferred for highly sensitive values.
# AI_STUDIO_SECRETS=~/.ai_studio/secrets.env

# --- Model provider API keys (fill the ones you have) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
VOYAGE_API_KEY=

# Which provider to use for embeddings (memory). Anthropic has none.
#   google | openai | voyage
EMBEDDINGS_PROVIDER=

# --- Stakeholder WhatsApp (Meta WhatsApp Business Cloud API) ---
# See docs/onboarding.md for how to obtain these.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Personal — the number that receives studio notifications. LOCAL ONLY.
STAKEHOLDER_WHATSAPP_NUMBER=

# --- Public webhook tunnel (needed for WhatsApp inbound) ---
#   cloudflared | tailscale | ngrok
TUNNEL_PROVIDER=
CLOUDFLARED_TUNNEL_TOKEN=

# --- Local infra credentials (generated by onboarding; not personal) ---
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
