# ===== AI Studio environment =====
# Copy to `.env` (git-ignored) via `scripts/onboarding.sh`. NEVER commit real
# values. Personal info (phone numbers, names) and secrets live ONLY in `.env`
# or an external secrets file (AI_STUDIO_SECRETS) — never in a tracked file.
#
# Leave blank anything you don't have yet; onboarding can be re-run to fill more.

AI_STUDIO_ENV=dev

# Optional: absolute path to an external secrets file (outside the repo) that is
# sourced in addition to .env. Preferred for highly sensitive values.
# AI_STUDIO_SECRETS=~/.ai_studio/secrets.env

# --- Model provider API keys (fill the ones you have) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
VOYAGE_API_KEY=
# Cursor: executor SUBSTRATE + guarded router adapter (NOT a keyed HTTP provider).
# Inference runs only via its agent-harness CLI (`cursor-agent -p ...`); this key
# authenticates that CLI. Keyless -> the cursor-cli adapter returns a dry-run stub.
CURSOR_API_KEY=

# Which provider to use for embeddings (memory). Anthropic has none.
#   google | openai | voyage
EMBEDDINGS_PROVIDER=

# Optional: coding worker CLI dispatched inside the sandbox (default: opencode).
#   opencode | cursor-agent
CODING_WORKER_CMD=

# --- Search provider API keys (all OPTIONAL) ---
# The search gateway (runtime/search/) reads a provider key from the matching env
# var. ALL are optional: with no key (or SEARCH_DRY_RUN=1) the gateway serves a
# keyless dry-run stub instead of calling out, so cold-start works without them.
# Fill the provider(s) you want live. Secrets — never commit real values.
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=

# --- Stakeholder WhatsApp (Meta WhatsApp Business Cloud API) ---
# See docs/onboarding.md for how to obtain these.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Personal — the number that receives studio notifications. LOCAL ONLY.
STAKEHOLDER_WHATSAPP_NUMBER=

# --- Spokesman service (stakeholder channel; ADR-0006). ---
# Channel: whatsapp (Meta Cloud API) | twilio_sms (Twilio Programmable SMS)
SPOKESMAN_CHANNEL=whatsapp
# SECRET: shared token gating POST /notify and /digest/flush (sent as the
# X-Spokesman-Token header). Fails closed — if unset, those endpoints are 401.
SPOKESMAN_API_TOKEN=
# Non-secret config below.
# Host port for the FastAPI webhook/service.
SPOKESMAN_PORT=8080
# Set to 1 to run with NO live creds: outbound sends are logged, not called out.
SPOKESMAN_DRY_RUN=0
# Meta Graph API base + version (override only if Meta changes them).
GRAPH_API_BASE=https://graph.facebook.com
GRAPH_API_VERSION=v21.0
# Where the Spokesman reads/writes state (inbox, status.md). Default: repo state/.
# AI_STUDIO_STATE_DIR=
# Human remote ops control-plane (ADR-0033): directory `docker compose` runs in
# for the token-gated `ops` commands. In-container the repo is mounted read-only
# at /app/repo (set by docker-compose.yml). Default off-container: the repo root.
# AI_STUDIO_COMPOSE_DIR=

# --- Twilio Programmable SMS (when SPOKESMAN_CHANNEL=twilio_sms) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Destination for outbound SMS (E.164 with +). Falls back to STAKEHOLDER_WHATSAPP_NUMBER.
TWILIO_TO_NUMBER=

# --- Public webhook tunnel (needed for WhatsApp inbound) ---
#   cloudflared | tailscale | ngrok
TUNNEL_PROVIDER=
CLOUDFLARED_TUNNEL_TOKEN=

# --- Task gateway: remote (non-LAN) task-queue access; ADR-0028 ---
# Lets a remote session (e.g. a cloud agent container) enqueue/list/claim work
# WITHOUT a DB credential and WITHOUT Postgres being exposed. Opt-in service:
#   docker compose --profile gateway up -d task-gateway
# See docs/remote-task-access.md. Mint a credential (auto-writes this file):
#   make gateway-provision IDENTITY=offhost-cursor SCOPES=read,enqueue,claim,complete
# Or: python3 -m gateway.client mint --identity offhost-cursor --scopes read,enqueue,claim,complete
#
# HASH-ONLY credential config: whitespace/comma-separated entries of
#   identity:scopes:sha256hex[:workstreams]      (scopes/workstreams are |-separated)
# The token SECRET is never stored here — only its SHA-256 digest — so a leaked
# .env yields no usable credential. EMPTY = fail closed (every task endpoint 503).
# `mint` upserts this automatically; do not paste digests by hand.
TASK_GATEWAY_TOKENS=
# Bind IP for the published port. Default 127.0.0.1 (local-first): remote access
# comes ONLY from an authenticated tunnel. NEVER bind a public interface.
TASK_GATEWAY_BIND_IP=127.0.0.1
TASK_GATEWAY_PORT=8081
# Per-identity rate limit (sustained requests/minute + instantaneous burst).
TASK_GATEWAY_RATE_PER_MIN=120
TASK_GATEWAY_BURST=20
# Bounded input / clamped authority (defaults are sane; raise deliberately).
# TASK_GATEWAY_MAX_BODY_BYTES=65536
# TASK_GATEWAY_MAX_PAYLOAD_BYTES=16384
# TASK_GATEWAY_MAX_PRIORITY=10
# TASK_GATEWAY_MAX_BUDGET_TOKENS=200000
# TASK_GATEWAY_MAX_LIMIT=100
#
# REMOTE side only (never set these on the host): where the remote reaches the
# gateway + its token secret. TASK_GATEWAY_TOKEN is a SECRET — never commit it.
# TASK_GATEWAY_URL=https://tasks.example.com
# TASK_GATEWAY_TOKEN=

# --- Local infra credentials (generated by onboarding; not personal) ---
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# --- Testing (ADR-0029): keep the LIVE studio DB sacred ---
# DB-backed tests seed synthetic tasks and NEVER clean up (isolation is by unique
# workstream). They REFUSE to run against a non-disposable database. A DB is
# "disposable" iff this var is truthy OR the target DB name matches a test pattern
# (ends with `_test` / contains `test`). Set this ONLY on a throwaway box, or point
# tests at a `*_test` database. `make test` sets it for you; do NOT put it in a
# prod host's environment. Leave BLANK on any host that runs the real studio.
# AI_STUDIO_TEST_DB=1

# --- Local infra config (defaults are fine; override if needed) ---
# POSTGRES_USER=aistudio
# POSTGRES_DB=aistudio
# GRAFANA_ADMIN_USER=admin
# Port overrides (only if a default port is taken):
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# QDRANT_HTTP_PORT=6333
# QDRANT_GRPC_PORT=6334
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# OTEL_GRPC_PORT=4317
# OTEL_HTTP_PORT=4318
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
