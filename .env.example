# ===== AI Studio environment =====
# Copy to `.env` (git-ignored) via `scripts/onboarding.sh`. NEVER commit real
# values. Personal info (phone numbers, names) and secrets live ONLY in `.env`
# or an external secrets file (AI_STUDIO_SECRETS) — never in a tracked file.
#
# Leave blank anything you don't have yet; onboarding can be re-run to fill more.

AI_STUDIO_ENV=dev

# Optional: absolute path to an external secrets file (outside the repo) that is
# sourced in addition to .env. Preferred for highly sensitive values.
# AI_STUDIO_SECRETS=~/.ai_studio/secrets.env

# --- Model provider API keys (fill the ones you have) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
VOYAGE_API_KEY=
# Cursor: executor SUBSTRATE + guarded router adapter (NOT a keyed HTTP provider).
# Inference runs only via its agent-harness CLI (`cursor-agent -p ...`); this key
# authenticates that CLI. Keyless -> the cursor-cli adapter returns a dry-run stub.
CURSOR_API_KEY=

# Which provider to use for embeddings (memory). Anthropic has none.
#   google | openai | voyage
EMBEDDINGS_PROVIDER=

# Optional: coding worker CLI dispatched inside the sandbox (default: opencode).
#   opencode | cursor-agent
CODING_WORKER_CMD=

# --- Search provider API keys (all OPTIONAL) ---
# The search gateway (runtime/search/) reads a provider key from the matching env
# var. ALL are optional: with no key (or SEARCH_DRY_RUN=1) the gateway serves a
# keyless dry-run stub instead of calling out, so cold-start works without them.
# Fill the provider(s) you want live. Secrets — never commit real values.
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=

# --- Stakeholder WhatsApp (Meta WhatsApp Business Cloud API) ---
# See docs/onboarding.md for how to obtain these.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Personal — the number that receives studio notifications. LOCAL ONLY.
STAKEHOLDER_WHATSAPP_NUMBER=

# --- Spokesman service (stakeholder channel; ADR-0006). ---
# Channel: whatsapp (Meta Cloud API) | twilio_sms (Twilio Programmable SMS)
SPOKESMAN_CHANNEL=whatsapp
# SECRET: shared token gating POST /notify and /digest/flush (sent as the
# X-Spokesman-Token header). Fails closed — if unset, those endpoints are 401.
SPOKESMAN_API_TOKEN=
# Non-secret config below.
# Host port for the FastAPI webhook/service.
SPOKESMAN_PORT=8080
# Set to 1 to run with NO live creds: outbound sends are logged, not called out.
SPOKESMAN_DRY_RUN=0
# Meta Graph API base + version (override only if Meta changes them).
GRAPH_API_BASE=https://graph.facebook.com
GRAPH_API_VERSION=v21.0
# Where the Spokesman reads/writes state (inbox, status.md). Default: repo state/.
# AI_STUDIO_STATE_DIR=

# --- Twilio Programmable SMS (when SPOKESMAN_CHANNEL=twilio_sms) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Destination for outbound SMS (E.164 with +). Falls back to STAKEHOLDER_WHATSAPP_NUMBER.
TWILIO_TO_NUMBER=

# --- Public webhook tunnel (needed for WhatsApp inbound) ---
#   cloudflared | tailscale | ngrok
TUNNEL_PROVIDER=
CLOUDFLARED_TUNNEL_TOKEN=

# --- Local infra credentials (generated by onboarding; not personal) ---
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# --- Local infra config (defaults are fine; override if needed) ---
# POSTGRES_USER=aistudio
# POSTGRES_DB=aistudio
# GRAFANA_ADMIN_USER=admin
# Port overrides (only if a default port is taken):
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# QDRANT_HTTP_PORT=6333
# QDRANT_GRPC_PORT=6334
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# OTEL_GRPC_PORT=4317
# OTEL_HTTP_PORT=4318
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
